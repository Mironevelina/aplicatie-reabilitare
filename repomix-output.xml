import { Router, Request, Response } from 'express';
import { proceseazaExercitiu, getIstoricPacient } from '../controllers/exerciseController.js';
import https from 'https';

const router = Router();

router.post('/proceseaza', proceseazaExercitiu);
router.get('/istoric/:id_pacient', getIstoricPacient);

router.post('/analiza-ai', async (req: Request, res: Response) => {
  try {
    const { pacientNume, istoric } = req.body;

    if (!istoric || istoric.length === 0) {
      return res.status(400).json({
        success: false,
        message: "Date insuficiente pentru analiza AI."
      });
    }

    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey) {
      return res.status(500).json({
        success: false,
        message: "Cheia API Gemini nu este configurata in .env."
      });
    }

    // Transformăm istoricul într-un text plat, foarte curat, ușor de digerat de inteligența artificială
    const istoricText = istoric
      .map((s: any) => `Data: ${s.data || 'N/A'}, Acuratete: ${s.scor_acuratete || 0}%`)
      .join('\n');

    const promptText = `
Ești un expert clinician în kinetoterapie și reabilitare motorie neuro-musculară.
Analizează evoluția istorică cronologică a pacientului ${pacientNume} pe baza următoarelor date din exerciții:
${istoricText}

Cerințe pentru evaluarea de licență:
1. Urmărește trendul datelor și precizează în mod explicit dacă se observă o EVOLUȚIE clinică (progres) sau o INVOLUȚIE (regres/stagnare a funcției motorii).
2. Oferă o scurtă recomandare terapeutică utilă pentru recuperarea pacientului.

Restricții vizuale:
- Răspunsul trebuie redactat exclusiv în limba română.
- Rezumatul trebuie să fie foarte concis (maxim 3 rânduri text), adaptat să apară curat sub un grafic.
- Păstrează un ton academic și extrem de profesionist.
`;

    // Împachetăm corpul cererii conform specificației oficiale Google
    const postData = JSON.stringify({
      contents: [
        {
          parts: [
            {
              text: promptText
            }
          ]
        }
      ]
    });

    const options = {
      hostname: 'generativelanguage.googleapis.com',
      port: 443,
      path: `/v1/models/gemini-1.5-flash:generateContent?key=${apiKey}`,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(postData)
      }
    };

    // Apelul asincron asigurat de modulul https
    const apiCall = () => {
      return new Promise<string>((resolve, reject) => {
        const reqGoogle = https.request(options, (resGoogle) => {
          let body = '';
          resGoogle.on('data', (chunk) => body += chunk);
          resGoogle.on('end', () => resolve(body));
        });

        reqGoogle.on('error', (err) => reject(err));
        reqGoogle.write(postData);
        reqGoogle.end();
      });
    };

    const rawResult = await apiCall();
    
    // Începem parsarea defensivă pentru a prinde orice variație de răspuns JSON de la Google
    let data: any;
    try {
      data = JSON.parse(rawResult);
    } catch (e) {
      console.error("Eroare la parsarea JSON-ului brut de la Google:", rawResult);
      throw new Error("Răspunsul primit de la Google nu este un JSON valid.");
    }

    // Extragere pe straturi sigure a textului generat de AI
    let responseText = "";
    if (data.candidates?.[0]?.content?.parts?.[0]?.text) {
      responseText = data.candidates[0].content.parts[0].text;
    } else if (data.error?.message) {
      // Dacă Google ne-a întors o eroare structurată (ex: cheie invalidă sau cotă depășită)
      throw new Error(`Google API Message: ${data.error.message}`);
    } else {
      console.log("Structură ciudată primită de la Google:", JSON.stringify(data));
      responseText = "Analiza s-a finalizat, dar structura textului nu a putut fi citită direct.";
    }

    return res.json({
      success: true,
      analysis: responseText
    });

  } catch (error: any) {
    console.error("=== EROARE CRITICĂ GEMINI BACKEND ===");
    console.error(error.message || error);
    console.error("=====================================");

    return res.status(500).json({
      success: false,
      message: "Eroare la generarea interpretării AI.",
      details: error.message || "Verificați terminalul de server."
    });
  }
});

export default router;
