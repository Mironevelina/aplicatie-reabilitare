const buttonStyle: CSSProperties = { padding: '16px', background: 'linear-gradient(135deg, #ffb7c5, #ff8fa3)', color: 'white', border: 'none', borderRadius: '18px', fontSize: '16px', fontWeight: 800, cursor: 'pointer', marginTop: '10px' };
