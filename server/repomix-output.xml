<file path="src/index.ts">
import express from 'express';
import type { Request, Response } from 'express';
import cors from 'cors';
import dotenv from 'dotenv';
import { supabase } from './config/supabase.js';
import { calculeazaUnghi } from './lib/calcul-miscare.ts';

// Încărcăm variabilele de mediu
dotenv.config();

const app = express();
const PORT = process.env.PORT || 5000;

// Middleware
app.use(cors()); // Permite Frontend-ului să comunice cu Serverul
app.use(express.json({ limit: '50mb' })); // Permite primirea de date JSON (mărit pentru landmarks)

// 1. Ruta de Test pentru Server
app.get('/', (req: Request, res: Response) => {
  res.send('Serverul de Reabilitare funcționează și e gata de procesat date!');
});

// 2. Ruta de Test pentru Baza de Date
app.get('/test-db', async (req: Request, res: Response) => {
  try {
    const { data, error } = await supabase.from('pacienti').select('*').limit(1);
    if (error) throw error;
    res.json({ message: "Conexiune reușită la Supabase!", data });
  } catch (error: any) {
    res.status(500).json({ error: error.message });
  }
});

// 3. RUTA PRINCIPALĂ: Procesarea Mișcării (MediaPipe)
app.post('/proceseaza-exercitiu', async (req: Request, res: Response) => {
  const { pacient_id, landmarks, tip_exercitiu } = req.body;

  try {
    // Verificăm dacă am primit datele corecte
    if (!landmarks || landmarks.length < 16) {
      return res.status(400).json({ error: "Date MediaPipe insuficiente." });
    }

    // Calculăm unghiul (Exemplu pentru cot: Umăr=11, Cot=13, Încheietură=15)
    const unghi = calculeazaUnghi(landmarks[11], landmarks[13], landmarks[15]);
    
    // Logica de validare (exemplu simplu)
    let este_corect = false;
    if (tip_exercitiu === 'flexie_cot' && unghi < 60) {
        este_corect = true;
    }

    // Salvare în baza de date dacă mișcarea a fost finalizată (exemplu)
    if (este_corect) {
        const { error } = await supabase
            .from('progres_pacienti')
            .insert([{ 
                pacient_id: pacient_id, 
                tip_exercitiu: tip_exercitiu, 
                scor: Math.round(unghi),
                data_finalizare: new Date().toISOString()
            }]);
        
        if (error) throw error;
    }

    // Trimitem rezultatul înapoi la Frontend pentru feedback instant
    res.json({ 
        success: true, 
        unghi: Math.round(unghi), 
        este_corect,
        mesaj: este_corect ? "Mișcare corectă!" : "Continuă flexia..."
    });

  } catch (error: any) {
    console.error("Eroare procesare:", error);
    res.status(500).json({ error: error.message });
  }
});

app.listen(PORT, () => {
  console.log(`🚀 Serverul rulează pe: http://localhost:${PORT}`);
});
</file>

<file path="src/lib/calcul-miscare.ts">
export const calculeazaUnghi = (A: any, B: any, C: any): number => {
    const radians = Math.atan2(C.y - B.y, C.x - B.x) - Math.atan2(A.y - B.y, A.x - B.x);
    let angle = Math.abs((radians * 180.0) / Math.PI);
    
    if (angle > 180.0) angle = 360 - angle;
    
    return angle;
};
</file>

